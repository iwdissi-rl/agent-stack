#!/usr/bin/env python3
"""tb — the local agent's persistent toolbox (/mnt/data/la-toolbox).

Everything installed here survives across chats, missions, sandbox restarts and profiles, and works both inside
the Docker sandbox and on the host (same path, conda packages are self-contained). Before installing anything,
`tb find <word>`; after making something work, `tb register` it so the next chat reuses it instead of redoing it.

  tb list [--json]                      every registered tool (name, where, one-line description)
  tb find <words>                       search names, descriptions and recipes
  tb show <name>                        the full recipe: how it was installed, how to run it, gotchas
  tb install <conda-pkg>...             conda-forge packages into the main env (ffmpeg, pandoc, nodejs, nmap...)
  tb pip <pkg>...                       into the shared Python venv  (/mnt/data/la-toolbox/venvs/py, `tbpy`)
  tb npm <pkg>...                       global npm packages          (/mnt/data/la-toolbox/npm/bin on PATH)
  tb env <name> <conda-pkg>...          a separate conda env at envs/<name> (when versions clash, e.g. jdk17)
  tb register <name> --desc "..." [--where sandbox|host|both] [--run "cmd"] [--install "how"] [--notes "..."]
                                        record a tool/process; writes recipes/<name>.md (edit it freely after)
  tb unregister <name>                  forget a tool (registry + recipe + shim; nothing is uninstalled)
  tb java <17|21|25>                    print the JAVA_HOME for that JDK (eval "$(tb java 21 --export)")
  tb doctor                             check PATH and that every registered command still resolves
  tb shims                              regenerate shims/ (usage counters for env/bin commands; automatic after install/register)
  tb usage [name]                       how often tools were used (logs/usage.jsonl; the HUD Toolbox page shows the same)

Host tools (run on the real desktop, e.g. Lunar Client): put an executable script in /mnt/data/la-toolbox/host/,
`tb register <name> --where host ...`, then call the crew tool `host_run(tool=<name>, args=[...])`.
"""
from __future__ import annotations

import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

TB = Path("/mnt/data/la-toolbox")
REG = TB / "registry.json"
RECIPES = TB / "recipes"
MM = TB / "bin/micromamba"
os.environ.setdefault("MAMBA_ROOT_PREFIX", str(TB / "mamba"))
TB_PATH = f"{TB}/bin:{TB}/env/bin:{TB}/npm/bin:{os.environ.get('PATH', '')}"   # what `tb doctor` resolves against
USAGE = TB / "logs/usage.jsonl"      # one JSON line per use (tb commands, shimmed commands, wrappers, host runs) -> HUD Toolbox page
SHIMS = TB / "shims"                 # generated: <cmd> = count the use, then exec env/bin/<cmd>; on PATH right after bin/
os.environ.setdefault("UV_CACHE_DIR", str(TB / "cache/uv"))
SHIM_MARK = "# toolbox shim (generated by `tb shims`"
SHIM = """#!/bin/sh
{mark}): counts the use in logs/usage.jsonl, then runs the real command. Do not edit; `tb shims` regenerates.
printf '{{"ts":%s,"tool":"{name}","kind":"cmd","args":"%s","where":"%s"}}\\n' "$(date +%s)" "$(printf '%s' "$*" | tr -d '"\\\\\\n\\r\\t' | cut -c1-120)" "$([ -e /.dockerenv ] && echo sandbox || echo host)" >> {usage} 2>/dev/null
exec "{real}" "$@"
"""


def where_am_i() -> str:
    return "sandbox" if Path("/.dockerenv").exists() else "host"


def log_usage(tool: str, kind: str, args: str = "") -> None:
    try:
        USAGE.parent.mkdir(parents=True, exist_ok=True)
        with open(USAGE, "a") as fh:
            fh.write(json.dumps({"ts": round(time.time(), 1), "tool": tool, "kind": kind, "args": args[:120], "where": where_am_i()}) + "\n")
    except OSError:
        pass


def write_shims(reg: dict) -> int:
    """One shim per registered command that lives in env/bin or npm/bin (scripts in bin/ log themselves)."""
    SHIMS.mkdir(exist_ok=True)
    want = {}
    for n, t in reg["tools"].items():
        if t.get("where") == "host":
            continue
        exe = (t.get("run") or "").split()[0] if t.get("run") else ""
        if not exe or "/" in exe or exe.startswith(("<", "$", "eval", "export", "host_run", "PLAYWRIGHT")) or (TB / "bin" / exe).exists():
            continue
        for d in (TB / "env/bin", TB / "npm/bin"):
            if (d / exe).is_file():
                want[exe] = d / exe
                break
    for old in SHIMS.iterdir():
        if old.name not in want and old.is_file() and SHIM_MARK in old.read_text(errors="replace")[:200]:
            old.unlink()
    for name, real in want.items():
        sp = SHIMS / name
        body = SHIM.format(mark=SHIM_MARK, name=name, real=real, usage=USAGE)
        if not sp.exists() or sp.read_text(errors="replace") != body:
            sp.write_text(body)
            sp.chmod(0o755)
    return len(want)

# conda-forge package name -> the command it actually provides (used by `tb install` auto-register and `tb doctor`)
BIN = {"ripgrep": "rg", "fd-find": "fd", "duckdb-cli": "duckdb", "graphviz": "dot", "imagemagick": "magick", "librsvg": "rsvg-convert",
       "maven": "mvn", "mermaid-cli": "mmdc", "poppler": "pdftotext", "rust": "cargo", "sqlite": "sqlite3", "openjdk": "java",
       "nodejs": "node", "ghostscript": "gs", "git-lfs": "git-lfs", "tectonic": "tectonic", "yt-dlp": "yt-dlp"}


def load() -> dict:
    try:
        return json.loads(REG.read_text())
    except FileNotFoundError:
        return {"tools": {}}


def save(reg: dict) -> None:
    tmp = REG.with_suffix(".tmp")
    tmp.write_text(json.dumps(reg, indent=1, sort_keys=True))
    tmp.replace(REG)
    write_index(reg)
    write_shims(reg)


def write_index(reg: dict) -> None:
    """TOOLBOX.md: the human/agent-readable index (the HUD also injects a short form into every agent prompt)."""
    lines = ["# Toolbox index (generated by `tb`; edit recipes/, not this file)", "",
             "| tool | where | what | run |", "|---|---|---|---|"]
    for n, t in sorted(reg["tools"].items()):
        lines.append(f"| {n} | {t.get('where', 'both')} | {t.get('desc', '')} | `{t.get('run', '')}` |")
    (TB / "TOOLBOX.md").write_text("\n".join(lines) + "\n")


class locked:
    def __enter__(self):
        self.fh = open(TB / ".lock", "w")
        fcntl.flock(self.fh, fcntl.LOCK_EX)
        return self

    def __exit__(self, *a):
        fcntl.flock(self.fh, fcntl.LOCK_UN)
        self.fh.close()


def register(name: str, desc: str, where: str = "both", run: str = "", install: str = "", notes: str = "",
             by: str = "agent") -> None:
    name = re.sub(r"[^a-zA-Z0-9_.+-]", "-", name).strip("-")
    with locked():
        reg = load()
        old = reg["tools"].get(name, {})
        t = {**old, "desc": desc[:160] or old.get("desc", ""), "where": where or old.get("where", "both"),
             "run": run or old.get("run", ""), "updated": time.strftime("%Y-%m-%d %H:%M"), "by": by}
        t.setdefault("created", t["updated"])
        reg["tools"][name] = t
        save(reg)
    RECIPES.mkdir(exist_ok=True)
    rp = RECIPES / f"{name}.md"
    if not rp.exists():
        rp.write_text(f"# {name}\n\n{desc}\n\n- where: {where}\n- run: `{run}`\n\n## Install\n{install or '(already installed)'}\n\n"
                      f"## Notes / gotchas\n{notes}\n")
    else:
        with open(rp, "a") as fh:
            if install:
                fh.write(f"\n## Install (update {t['updated']})\n{install}\n")
            if notes:
                fh.write(f"\n## Notes ({t['updated']})\n{notes}\n")
    print(f"registered {name} -> {rp}")


def sh(cmd: list[str]) -> int:
    print("+", " ".join(cmd), flush=True)
    return subprocess.call(cmd)


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    cmd, rest = argv[0], argv[1:]
    reg = load()
    log_usage("tb", "tb", " ".join(argv))
    if cmd == "show" and rest:
        log_usage(rest[0], "recipe", "tb show")
    if cmd in ("install", "pip", "npm", "env") and rest:
        for pk in (rest[1:] if cmd == "env" else rest):
            base = re.split(r"[=<>\[]", pk)[0]
            log_usage({"pip": "py-" + base.lower(), "npm": "npm-" + base.split("@")[0 if not base.startswith("@") else 1].strip("/"),
                       "env": "env-" + rest[0]}.get(cmd, base), "install", f"tb {cmd} {pk}")
    if cmd == "register" and rest:
        log_usage(rest[0], "register", "tb register")
    if cmd == "unregister":
        name = rest[0]
        with locked():
            reg = load()
            if name not in reg["tools"]:
                print(f"no tool {name!r}")
                return 1
            del reg["tools"][name]
            save(reg)
        (RECIPES / f"{name}.md").unlink(missing_ok=True)
        print(f"unregistered {name} (files/packages untouched)")
        return 0
    if cmd == "shims":
        print(f"{write_shims(reg)} shims in {SHIMS}")
        return 0
    if cmd == "usage":
        from collections import Counter
        c, last = Counter(), {}
        try:
            for line in open(USAGE):
                try:
                    e = json.loads(line)
                except Exception:
                    continue
                if rest and e.get("tool") != rest[0]:
                    continue
                c[e.get("tool", "?")] += 1
                last[e.get("tool", "?")] = e
        except FileNotFoundError:
            pass
        for n, k in c.most_common(40):
            e = last[n]
            print(f"{n:24} {k:6}  last {time.strftime('%Y-%m-%d %H:%M', time.localtime(e.get('ts', 0)))} {e.get('where', ''):7} {e.get('kind', '')} {e.get('args', '')[:60]}")
        return 0
    if cmd == "list":
        if "--json" in rest:
            print(json.dumps(reg["tools"], indent=1))
        else:
            for n, t in sorted(reg["tools"].items()):
                print(f"{n:24} {t.get('where', 'both'):7} {t.get('desc', '')}")
        return 0
    if cmd == "find":
        words = [w.lower() for w in rest]
        for n, t in sorted(reg["tools"].items()):
            text = (n + " " + t.get("desc", "") + " " + t.get("run", "")).lower()
            rp = RECIPES / f"{n}.md"
            if rp.exists():
                text += rp.read_text().lower()
            if all(w in text for w in words):
                print(f"{n:24} {t.get('where', 'both'):7} {t.get('desc', '')}")
        return 0
    if cmd == "show":
        rp = RECIPES / f"{rest[0]}.md"
        print(json.dumps(reg["tools"].get(rest[0], {}), indent=1))
        print(rp.read_text() if rp.exists() else "(no recipe)")
        return 0
    if cmd == "install":
        with locked():
            code = sh([str(MM), "install", "-y", "-p", str(TB / "env"), "-c", "conda-forge", *rest])
        if code == 0:
            for p in rest:
                n = re.split(r"[=<>]", p)[0]
                if n not in reg["tools"]:
                    register(n, f"conda-forge package {n} (main env)", "both", BIN.get(n, n), f"tb install {p}")
        return code
    if cmd == "env":
        name, pkgs = rest[0], rest[1:]
        with locked():
            code = sh([str(MM), "create", "-y", "-p", str(TB / "envs" / name), "-c", "conda-forge", *pkgs])
        if code == 0:
            register(f"env-{name}", f"conda env with {' '.join(pkgs)}", "both", f"{TB}/envs/{name}/bin/<cmd>",
                     f"tb env {name} {' '.join(pkgs)}")
        return code
    if cmd == "pip":
        with locked():
            uv = TB / "env/bin/uv"
            code = sh([str(uv), "pip", "install", "-p", str(TB / "venvs/py/bin/python"), *rest])
        if code == 0:
            for p in rest:
                n = "py-" + re.split(r"[=<>\[]", p)[0].lower()
                if n not in reg["tools"]:
                    register(n, f"Python package {p} in the shared venv", "both", f"tbpy -c 'import ...'", f"tb pip {p}")
        return code
    if cmd == "npm":
        with locked():
            code = sh([str(TB / "env/bin/npm"), "install", "-g", "--prefix", str(TB / "npm"), *rest])
        if code == 0:
            for p in rest:
                n = "npm-" + p.split("@")[0 if not p.startswith("@") else 1].strip("/")
                register(n, f"npm package {p}", "both", "", f"tb npm {p}")
        return code
    if cmd == "register":
        import argparse
        ap = argparse.ArgumentParser(prog="tb register")
        ap.add_argument("name")
        ap.add_argument("--desc", required=True)
        ap.add_argument("--where", default="both", choices=["sandbox", "host", "both"])
        ap.add_argument("--run", default="")
        ap.add_argument("--install", default="")
        ap.add_argument("--notes", default="")
        a = ap.parse_args(rest)
        if a.where == "host" and not (TB / "host" / a.name).is_file():
            print(f"note: host tools are run by host_run(tool='{a.name}') from {TB}/host/{a.name} — create that script")
        register(a.name, a.desc, a.where, a.run, a.install, a.notes)
        return 0
    if cmd == "java":
        v = rest[0] if rest else "25"
        home = TB / ("env" if v == "25" else f"envs/jdk{v}") / "lib/jvm"
        if not (home / "bin/java").exists():
            print(f"no JDK {v} (have: 17, 21, 25)", file=sys.stderr)
            return 1
        print(f"export JAVA_HOME={home} PATH={home}/bin:$PATH" if "--export" in rest else home)
        return 0
    if cmd == "doctor":
        bad = 0
        for n, t in sorted(reg["tools"].items()):
            exe = (t.get("run") or "").split()[0] if t.get("run") else ""
            if t.get("where") == "host":
                ok = (TB / "host" / n).is_file()
            elif exe and not exe.startswith(("<", "tbpy", "$", "eval", "export", "host_run", "PLAYWRIGHT", "java")) and "/" not in exe:
                ok = shutil.which(exe, path=TB_PATH) is not None
            else:
                ok = True
            if not ok:
                bad += 1
                print(f"MISSING {n}: {exe or 'host/' + n}")
        on_path = str(TB / "bin") in os.environ.get("PATH", "") and str(TB / "env/bin") in os.environ.get("PATH", "")
        print(f"{len(reg['tools'])} tools, {bad} missing; PATH has toolbox bin+env/bin: {on_path}"
              + ("" if on_path else f"  (fix: export PATH={TB}/bin:$PATH:{TB}/env/bin)"))
        return 1 if bad else 0
    print(f"unknown command {cmd!r}\n{__doc__}")
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
