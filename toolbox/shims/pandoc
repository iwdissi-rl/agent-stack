#!/bin/sh
# toolbox shim (generated by `tb shims`): counts the use in logs/usage.jsonl, then runs the real command. Do not edit; `tb shims` regenerates.
printf '{"ts":%s,"tool":"pandoc","kind":"cmd","args":"%s","where":"%s"}\n' "$(date +%s)" "$(printf '%s' "$*" | tr -d '"\\\n\r\t' | cut -c1-120)" "$([ -e /.dockerenv ] && echo sandbox || echo host)" >> /mnt/data/la-toolbox/logs/usage.jsonl 2>/dev/null
exec "/mnt/data/la-toolbox/env/bin/pandoc" "$@"
