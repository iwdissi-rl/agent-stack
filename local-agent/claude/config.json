{
  "enabled": true,
  "default_model": "opus",
  "default_effort": "high",
  "judge": "required",
  "judge_url": "http://127.0.0.1:8181/v1/chat/completions",
  "judge_timeout_s": 180,
  "max_concurrent": 2,
  "max_per_hour": 10,
  "max_turns": 60,
  "max_turns_cap": 150,
  "timeout_s": 1800,
  "timeout_cap": 7200,
  "max_task_chars": 6000,
  "max_context_chars": 16000,
  "max_files": 40,
  "sandbox": "required",
  "network_domains": [
    "pypi.org",
    "files.pythonhosted.org",
    "registry.npmjs.org",
    "github.com",
    "objects.githubusercontent.com",
    "raw.githubusercontent.com",
    "crates.io",
    "static.crates.io",
    "proxy.golang.org"
  ],
  "bash_allow": [
    "python3",
    "python",
    "pytest",
    "pip",
    "pip3",
    "uv",
    "node",
    "npm",
    "npx",
    "pnpm",
    "yarn",
    "go",
    "cargo",
    "make",
    "ruff",
    "pyflakes",
    "mypy",
    "black",
    "eslint",
    "tsc",
    "git diff",
    "git status",
    "git log",
    "git show",
    "ls",
    "cat",
    "head",
    "tail",
    "wc",
    "grep",
    "rg",
    "find",
    "diff",
    "mkdir",
    "sed -n",
    "sort",
    "uniq",
    "tree",
    "pwd",
    "echo"
  ]
}
