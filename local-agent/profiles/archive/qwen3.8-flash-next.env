# Qwen3.8-Flash-Next abliterated (125B MoE, 6B active) — attention/shared on GPU, routed experts in RAM.
# KV is tiny (12 full-attention layers x 2 KV heads): full 256k ctx ≈ 6 GiB f16.
# Tuned 2026-10-11: gen ~19 tok/s is flat across threads (32-96) and GPU expert layers; -ub 4096
# buys +40% prefill (930 vs 660 tok/s) and uses the VRAM that expert layers would otherwise get.
MODEL=/mnt/data/local-agent/models/qwen3.8-flash-next/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf
MMPROJ=/mnt/data/local-agent/models/qwen3.8-flash-next/mmproj-Qwen3.8-Flash-Next-BF16.gguf
CTX=262144
N_CPU_MOE=48
# per_layer_token_embd = the 28.8 GB n-gram embedding table: a per-token lookup, so it lives in RAM.
SERVER_ARGS="-ngl 99 --n-cpu-moe $N_CPU_MOE -ot per_layer_token_embd\.weight=CPU -fa on -ctk q8_0 -ctv q8_0 -b 4096 -ub 4096 -np 1 -t 48"
SAMPLING="--temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0"
