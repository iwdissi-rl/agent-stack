# Qwen3.8-27B abliterated (dense, hybrid DeltaNet/attention) — fully on the 24 GB GPU.
# KV cost is small (16 full-attention layers x 4 KV heads): 128k ctx at q8_0 ≈ 4 GiB.
MODEL=/mnt/data/local-agent/models/qwen3.8-27b-huihui/Huihui-Qwen3.8-27B-abliterated-UD-DW-Q4_K_M.gguf
MMPROJ=/mnt/data/local-agent/models/qwen3.8-27b-huihui/mmproj-model-bf16.gguf
CTX=131072
SERVER_ARGS="-ngl 99 -fa on -ctk q8_0 -ctv q8_0 -b 2048 -ub 512 -np 1 -t 16"
# Qwen card, thinking mode
SAMPLING="--temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0"
