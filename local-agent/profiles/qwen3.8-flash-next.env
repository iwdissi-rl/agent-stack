# Qwen3.8-Flash-Next abliterated (125B MoE, 6B active) — attention on GPU, routed experts in RAM.
# Measured 2026-10-11 (warm, under systemd): gen 45.6 tok/s short / 35.7 @100k; prefill 1,262 @16k / 1,172 @100k.
# (First runs right after the 112 GB download gave only ~19 / ~930 — likely page-cache writeback; same flags.)
# UBATCH 4096 buys ~+40% prefill over 2048. EXTRA_ARGS keeps the 28.8 GB n-gram embedding table in RAM.
# Plain KEY=value only: scripts/run-model.sh builds the llama-server command and the web HUD edits these.
MODEL=/mnt/data/local-agent/models/qwen3.8-flash-next/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf
MMPROJ=/mnt/data/local-agent/models/qwen3.8-flash-next/mmproj-Qwen3.8-Flash-Next-BF16.gguf
CTX=262144
NGL=99
N_CPU_MOE=48
THREADS=48
PARALLEL=8
BATCH=4096
UBATCH=1024
KV_TYPE=q8_0
TEMP=1.0
TOP_P=0.95
TOP_K=20
MIN_P=0.0
EXTRA_ARGS="-ot per_layer_token_embd\.weight=CPU --spec-type ngram-mod -cms 1024 -ctxcp 64 --cache-ram 49152"
# Per-agent context window (Hermes context_length). 512k pool OOMed (24 GB card: KV + attention scratch scale with CTX); 384k fits.
# HUD runs at most floor(0.75*CTX / AGENT_CTX) agents at once (3 here): Hermes only checks its window between turns, so one
# turn's tool results can overshoot it by 15k+ (an 80k request was seen with a 65k window) — the 25% headroom absorbs that.
# Without headroom the pool overflowed twice (2026-10-22 14:58, 2026-10-23 03:28) and every running agent died at once.
# Hermes' minimum window is 64,000; the fixed part of a request is ~19k (lead) / ~14k (member), measured 2026-10-23.
# 2026-10-22 incident: 4 agents at 79k+54k+82k+50k = 265k > 262k pool -> all four requests failed "context size exceeded".
AGENT_CTX=98304
